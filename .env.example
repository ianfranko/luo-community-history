# ─── Copy to .env and fill in. Never commit the real .env (it is gitignored). ───

# MySQL connection string. On Namecheap cPanel see DEPLOY.md Step 2.
# Local dev example: mysql://root:root@localhost:3306/luo
DATABASE_URL="mysql://user:password@localhost:3306/dbname?connection_limit=3&pool_timeout=20&connect_timeout=15"

# NextAuth secret — REQUIRED in production. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# v5 is on beta here; set both to the same value.
NEXTAUTH_SECRET=""

# Public base URL of the deployed site (used by NextAuth callbacks).
AUTH_URL="https://luoleagueofnations.com"
NEXTAUTH_URL="https://luoleagueofnations.com"
# Required when running behind a reverse proxy such as cPanel/Passenger.
AUTH_TRUST_HOST="true"

# Google OAuth (optional). Leave BOTH blank to disable Google sign-in;
# also set NEXT_PUBLIC_GOOGLE_ENABLED=false to hide the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="true"

# Google Analytics measurement id (optional, e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=""
