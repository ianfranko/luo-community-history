# ─── Copy to .env and fill in. Never commit the real .env (it is gitignored). ───
# On Vercel, set these in Project → Settings → Environment Variables instead.

# ── Neon Postgres ──────────────────────────────────────────────────────────────
# DATABASE_URL: the POOLED connection (host contains "-pooler"). Used at runtime.
#   Append ?sslmode=require&pgbouncer=true
# DIRECT_URL: the DIRECT connection (no "-pooler"). Used by `prisma migrate`.
#   Append ?sslmode=require
# Copy both from the Neon dashboard → Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
# Public base URL of the deployed site.
AUTH_URL="https://www.luoleagueofnations.com"
NEXTAUTH_URL="https://www.luoleagueofnations.com"
AUTH_TRUST_HOST="true"

# ── Google OAuth (optional) ───────────────────────────────────────────────────────
# Leave BOTH blank to disable Google sign-in; also set NEXT_PUBLIC_GOOGLE_ENABLED=false.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="true"

# ── Google Analytics (optional) ────────────────────────────────────────────────────
# e.g. G-XXXXXXXXXX. Leave blank to disable. Build-time (NEXT_PUBLIC_*).
NEXT_PUBLIC_GA_ID=""
